 # Haackummit backend environment
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapse123

# One OpenRouter key shared by the ordered fallback chain.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL_CHAIN=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-120b:free,google/gemma-4-31b-it:free,openrouter/free
KNOWLEDGE_TRANSFER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

ALLOWED_ORIGINS=*
AUTH_REQUIRED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

SYNTHESIZER_TIMEOUT_S=45
SYNTHESIZER_MAX_TOKENS=1200
SYNTHESIZER_REASONING_EFFORT=medium
ROUTER_TIMEOUT_S=20
ROUTER_MAX_TOKENS=500

# Optional mounted data paths.
# DUCKDB_DIR=/data/duckdb
# CHROMA_DIR=/data/chroma
